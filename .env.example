# Stripe. Use test-mode values while developing.
STRIPE_SECRET_KEY=sk_test_replace_me
# Printed by `stripe listen`, or shown on the webhook endpoint in the Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO_MONTHLY=price_replace_me
STRIPE_PRICE_PRO_YEARLY=price_replace_me

# Public base URL, used for Checkout success/cancel and Billing Portal return URLs.
APP_URL=http://localhost:3000

# Days a past_due subscription keeps pro access, counted from when it became past due.
PAST_DUE_GRACE_DAYS=7

# "sqlite" (default) or "memory".
BILLING_STORE=sqlite
DATABASE_PATH=./data/billing.db

# Local demo only: trust x-demo-user-id / x-demo-user-email headers as the signed-in user.
# Leave unset (or false) anywhere real users can reach the app.
ALLOW_DEMO_AUTH=true
